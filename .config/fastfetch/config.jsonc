{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo",
    "color": {
      "1": "white",
      "2": "black"
    }
  },
  "display": {
    "separator": ": ",     // Separator between keys and values
    "color": {
        "keys": "White",    // Key color
        "title": "cyan"     // Title color
    },
    "key": {
        "width": 30,       // Aligns keys to this width
        "type": "string"   // string, icon, both, or none
    },
    "bar": {
        "width": 20,       // Width of percentage bars
        "char": {
            "elapsed": "■", // Character for elapsed portion
            "total": "-",    // Character for total portion
        },
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│ OS"
    },
    {
      "type": "kernel",
      "key": "│ Kernel"
    },
    {
      "type": "uptime",
      "key": "│ Uptime"
    },
    {
      "type": "packages",
      "key": "│ Packages"
    },
    {
      "type": "shell",
      "key": "│ Shell"
    },
    {
      "type": "display",
      "key": "│ Display ({name})"
    },
    {
      "type": "de",
      "key": "│ DE"
    },
    {
      "type": "WM",
      "key": "│ WM"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────────────────────────────╮"
    },
    {
      "type": "wmtheme",
      "key": "│ Wmtheme"
    },
    {
      "type": "theme",
      "key": "│ Theme"
    },
    {
      "type": "icons",
      "key": "│ Icons"
    },
    {
      "type": "font",
      "key": "│ Font"
    },
    {
      "type": "cursor",
      "key": "│ Cursor"
    },
    {
      "type": "terminal",
      "key": "│ Terminal"
    },
    {
      "type": "terminalfont",
      "key": "│ Terminal Font"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "│ CPU"
    },
    {
      "type": "gpu",
      "key": "│ GPU"
    },
    {
      "type": "memory",
      "key": "│ Memory"
    },
    {
      "type": "swap",
      "key": "│ Swap"
    },
    {
      "type": "disk",
      "key": "│ Disk ({1})"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────────────────────────────╮"
    },
    {
      "type": "localip",
      "key": "│ Local IP ({2})"
    },
    {
      "type": "poweradapter",
      "key": "│ Power Adapter"
    },
    {
      "type": "locale",
      "key": "│ Locale"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────────╯"
    },
    "colors"
  ]
}
