/* Основной контейнер */
window {
    width: 500px;
    height: 500px;
    border-radius: 24px;
    border: 5px;
    border-color: #000000;
    background-color: #ffffff;
}

/* Элементы управления (список, ввод) */
mainbox {
    children: [inputbar, listview];
}

/* Строка ввода */
inputbar {
    background-color: #ffffff;
    text-color: #000000;
    padding: 10px;
}

/* Список элементов */
listview {
    lines: 10;
    columns: 1;
    background-color: #ffffff;
}

/* Отдельный элемент списка */
element {
    padding: 5px;
    text-color: #ff0000;
}

/* Выбранный элемент */
element selected {
    background-color: #000000;
    text-color: #ffffff;
}
